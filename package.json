{
  "name": "arbiter",
  "productName": "Arbiter",
  "version": "0.3.2",
  "description": "Universal format converter for video, audio, images, documents, ebooks and archives.",
  "homepage": "https://github.com/Polaris-bit189/Arbiter#readme",
  "author": "Polaris <polaris@local>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polaris-bit189/Arbiter.git"
  },
  "bugs": {
    "url": "https://github.com/Polaris-bit189/Arbiter/issues"
  },
  "keywords": [
    "electron",
    "converter",
    "ffmpeg",
    "format-conversion",
    "video",
    "audio",
    "image",
    "document",
    "ebook",
    "archive",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:scripts",
    "test:core": "tsx scripts/test-core.ts",
    "test:doc": "tsx scripts/test-doc.ts",
    "test:tasks": "tsx --tsconfig tsconfig.test.json scripts/test-tasks.ts",
    "test:downlink": "tsx --tsconfig tsconfig.test.json scripts/test-downlink.ts",
    "test:pandoc": "tsx --tsconfig tsconfig.test.json scripts/test-pandoc.ts",
    "test:integration": "tsx --tsconfig tsconfig.test.json scripts/test-integration.ts",
    "test:cli": "tsx --tsconfig tsconfig.test.json scripts/test-cli.ts",
    "test:image-options": "tsx --tsconfig tsconfig.test.json scripts/test-image-options.ts",
    "test:install": "tsx --tsconfig tsconfig.test.json scripts/test-engine-install.ts",
    "test:pdf": "node scripts/run-pdf-test.mjs",
    "test:electron-free": "tsx --tsconfig tsconfig.test.json scripts/test-electron-free.ts",
    "test:mcp-view": "tsx --tsconfig tsconfig.test.json scripts/test-mcp-view.ts",
    "test:mcp-inspect": "tsx --tsconfig tsconfig.test.json scripts/test-mcp-inspect.ts",
    "test:mcp": "tsx --tsconfig tsconfig.test.json scripts/test-mcp-server.ts",
    "test:plugin": "node scripts/test-plugin-launch.mjs",
    "test:preload-imports": "tsx --tsconfig tsconfig.test.json scripts/test-preload-imports.ts",
    "test:anchors": "node scripts/falsify-anchors.mjs",
    "test:i18n": "tsx --tsconfig tsconfig.test.json scripts/test-i18n.ts",
    "test:audit": "tsx --tsconfig tsconfig.test.json scripts/test-audit-n1-o3.ts",
    "test": "npm run test:core && npm run test:doc && npm run test:integration && npm run test:cli && npm run test:image-options && npm run test:shortcuts && npm run test:ui && npm run test:install && npm run test:electron-free && npm run test:mcp-view && npm run test:mcp-inspect && npm run test:mcp && npm run test:tasks && npm run test:downlink && npm run test:pandoc && npm run test:pdf && npm run test:i18n && npm run test:audit && npm run test:preload-imports && npm run test:anchors",
    "falsify:doc": "node scripts/falsify-doc.mjs",
    "falsify:pandoc": "node scripts/falsify-pandoc.mjs",
    "falsify:pdf": "node scripts/falsify-pdf.mjs",
    "falsify:ui": "node scripts/falsify-ui.mjs",
    "falsify:tasks": "node scripts/falsify-tasks.mjs",
    "falsify:integration": "node scripts/falsify-integration.mjs",
    "falsify:electron-free": "node scripts/falsify-electron-free.mjs",
    "falsify:downlink": "node scripts/falsify-downlink.mjs",
    "falsify:engine-install": "node scripts/falsify-engine-install.mjs",
    "falsify:mcp": "node scripts/falsify-mcp.mjs",
    "falsify:plugin-launch": "node scripts/falsify-plugin-launch.mjs",
    "falsify": "npm run falsify:doc && npm run falsify:pandoc && npm run falsify:pdf && npm run falsify:ui && npm run falsify:image-options && npm run falsify:electron-free && npm run falsify:downlink && npm run falsify:mcp && npm run falsify:integration && npm run falsify:engine-install && npm run falsify:cli && npm run falsify:ui-panel && npm run falsify:shortcuts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "bench": "tsx --tsconfig tsconfig.test.json scripts/bench.ts",
    "gen:formats": "tsx scripts/gen-formats-doc.mjs",
    "test:ui": "tsx --tsconfig tsconfig.test.json scripts/test-ui.ts",
    "falsify:cli": "node scripts/falsify-cli.mjs",
    "falsify:ui-panel": "node scripts/falsify-ui-panel.mjs",
    "test:shortcuts": "tsx --tsconfig tsconfig.test.json scripts/test-shortcuts.ts",
    "falsify:image-options": "node scripts/falsify-image-options.mjs",
    "falsify:shortcuts": "node scripts/falsify-shortcuts.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.9",
    "7zip-bin": "^5.2.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
